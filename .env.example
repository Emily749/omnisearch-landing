# Supabase project (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public site URL, used for auth redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# /api/evaluate — used by the TrustTag browser companion to check products.
# Pick any secret string for the key; it must match TRUSTTAG_API_KEY in the
# extension's content.js exactly.
TRUSTTAG_EXTENSION_KEY=
TRUSTTAG_RATE_LIMIT_PER_MINUTE=120

# Optional: free-tier Gemini API key (get one at https://aistudio.google.com/apikey)
# for an AI second pass over scraped product text — catches phrasing the
# keyword matcher misses. Leave blank to skip it entirely; /api/evaluate
# works exactly the same without it. Results are cached per distinct
# product text in product_ai_cache (see migrations/0002_ai_cache.sql), so
# a given product only ever costs one AI call regardless of traffic.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Affiliate deep-link templates. {url} is replaced with the destination page.
# Fill these in once you're approved for each retailer's affiliate program
# (most run through a network like Awin, CJ or Rakuten Advertising).
AFFILIATE_TEMPLATE_TESCO=https://www.tesco.com/groceries/en-GB
AFFILIATE_TEMPLATE_SAINSBURYS=https://www.sainsburys.co.uk/gol-ui/groceries
AFFILIATE_TEMPLATE_WAITROSE=https://www.waitrose.com/ecom/shop/browse/groceries
